{
  "rules": {
    ".read": false,
    ".write": false,

    "mensagens": {
      ".read": true,
      "$message": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['user', 'text', 'time', 'avatar', 'uid'])",
        "user": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
        "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 240" },
        "time": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
        "avatar": { ".validate": "newData.isString() && newData.val().matches(/^avatar-(0[1-9]|[1-3][0-9]|40)$/)" },
        "uid": { ".validate": "newData.isString() && newData.val() == auth.uid" },
        "$other": { ".validate": false }
      }
    }
  }
}
