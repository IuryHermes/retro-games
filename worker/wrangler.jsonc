{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "webhook-pix-cafe",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "r2_buckets": [
    { "binding": "GAMES", "bucket_name": "neoterminalroom" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MULTIPLAYER_ROOMS", "class_name": "MultiplayerRoom" },
      { "name": "SOCIAL_PLAYERS", "class_name": "SocialPlayer" }
    ]
  },
  "migrations": [
    { "tag": "multiplayer-v1", "new_sqlite_classes": ["MultiplayerRoom"] },
    { "tag": "social-v1", "new_sqlite_classes": ["SocialPlayer"] }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": { "crons": ["15 12 * * *"] }
}
