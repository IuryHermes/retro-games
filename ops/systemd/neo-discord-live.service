[Unit]
Description=NeoTerminalRoom Discord Live Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/vndx404/neo-discord-live
EnvironmentFile=/home/vndx404/.config/neo-discord-live.env
ExecStart=/usr/bin/node tools/discord-live-monitor.mjs
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
