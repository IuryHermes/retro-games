[Unit]
Description=HERMES Discord - Boot Concursos
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/vndx404/hermes-discord/boot_concursos
ExecStart=/home/vndx404/hermes-discord/venv/bin/python bot.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
